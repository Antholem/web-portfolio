# Copy to .env.local for local development. In production set these in
# Vercel / GitHub environment settings instead.

# Gmail account the contact form sends from.
APP_FROM_EMAIL=
# Google App Password for that account (not the normal password):
# Google Account → Security → 2-Step Verification → App passwords.
APP_FROM_PASSWORD=
# Inbox that receives contact form messages.
APP_TO_EMAIL=

# Test-only: set to "json" to build messages without sending them (used by E2E).
# MAIL_TRANSPORT=json
